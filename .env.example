# URL do BarberFlow. Em produção, use a origem HTTPS com o mesmo valor do Site URL do Supabase Auth.
BARBERFLOW_APP_URL=http://localhost:3000

# Fuso IANA sugerido no primeiro cadastro. Cada estabelecimento grava seu próprio fuso.
BARBERFLOW_TIMEZONE=America/Fortaleza

# Use a URL do projeto e a chave publicável (sb_publishable_...).
# Preencha somente no .env.local ou no ambiente de implantação.
# SUPABASE_BOOKING_SECRET ativa catálogo e reservas públicas no servidor.
# Em produção, também é aceita a SUPABASE_SECRET_KEY da integração Vercel.
# Use uma chave de teste no desenvolvimento. Nunca use o prefixo NEXT_PUBLIC_.
